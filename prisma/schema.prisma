// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  phoneNumber  String?
  password     String
  firstName    String
  lastName     String
  role         Role
  visits       Visit[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  Notification Notification[]
}

model Visit {
  id             String      @id @default(cuid())
  userId         String
  sessionId      String
  startTime      String   @default("")
  endTime        String   @default("")
  institutionId  String  @default("")
  status         VisitStatus @default(PENDING)
  visitDate     DateTime
  visitors       String
  specialRequest String?
  createdAt      DateTime    @default(now())
  packageOption  String?
  tujuanId        String?
  updatedAt      DateTime    @updatedAt
  @@unique([sessionId, visitDate])
  user           User        @relation(fields: [userId], references: [id])
  session        Session     @relation(fields: [sessionId], references: [id])
  institution    Institution @relation(fields: [institutionId], references: [id])
  tujuan         Tujuan?     @relation(fields: [tujuanId], references: [id])
}

model Tujuan {
  id        String   @id @default(cuid())
  name      String
  visits   Visit[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  startTime String
  endTime   String
  visits    Visit[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Institution {
  id        String   @id @default(cuid())
  name      String
  isPaid    Boolean
  price     Int?
  visits    Visit[]
  packages  Package[]
  packageOption  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Package {
  id             String       @id @default(uuid())
  name           String
  value          String
  price          Int
  institutionId  String
  institution    Institution  @relation(fields: [institutionId], references: [id])
}

model Event {
  id              String   @id @default(cuid())
  title           String
  description     String?
  date            DateTime
  isBookingClosed Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model VisitSetting {
  id             String   @id @default(cuid())
  allowedWeekday Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

enum Role {
  ADMIN
  VISITOR
}

enum VisitStatus {
  PENDING
  APPROVED
  REJECTED
}
